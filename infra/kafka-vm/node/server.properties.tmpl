# Rendered by install-kafka.sh. Placeholders: __NODE_ID__, __NODE_HOST__, __NODE_RACK__,
# __BROKER_PASSWORD__ (that is why the rendered file is root:kafka 0640)

############################# KRaft #############################
# Combined mode: every node is both broker and controller.
# Fine for 3-node clusters; large production clusters run dedicated controllers.
process.roles=broker,controller
node.id=__NODE_ID__
controller.quorum.voters=1@kafka-1:9093,2@kafka-2:9093,3@kafka-3:9093
controller.listener.names=CONTROLLER

############################# Listeners #############################
# 9092: clients and broker-to-broker, authenticated with SASL/SCRAM-SHA-512.
#   SCRAM never sends the password itself, but the traffic is not encrypted yet -> TLS step (SASL_SSL).
# 9093: controller quorum, PLAINTEXT on the private lab network (KRaft cannot use SCRAM here,
#   because SCRAM credentials live in the metadata the controllers serve). Production: mTLS.
listeners=SASL_PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
advertised.listeners=SASL_PLAINTEXT://__NODE_HOST__:9092
inter.broker.listener.name=SASL_PLAINTEXT
listener.security.protocol.map=SASL_PLAINTEXT:SASL_PLAINTEXT,CONTROLLER:PLAINTEXT

############################# Authentication #############################
sasl.enabled.mechanisms=SCRAM-SHA-512
sasl.mechanism.inter.broker.protocol=SCRAM-SHA-512
# Credentials this broker uses towards the other brokers
listener.name.sasl_plaintext.scram-sha-512.sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required username="broker" password="__BROKER_PASSWORD__";

############################# Authorization #############################
authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer
# Deny by default: a principal can only do what an ACL allows
allow.everyone.if.no.acl.found=false
# broker: inter-broker traffic; admin: operator CLI.
# ANONYMOUS: requests arriving on the PLAINTEXT controller listener (only controller RPCs are served
# there). Drop it once the controller listener uses mTLS.
super.users=User:broker;User:admin;User:ANONYMOUS

############################# Placement #############################
# Rack-aware replica assignment: each replica of a partition lands on a different rack
broker.rack=__NODE_RACK__

############################# Storage #############################
# Holds both partition data and the __cluster_metadata log
log.dirs=/var/lib/kafka/data

############################# Durability #############################
default.replication.factor=3
min.insync.replicas=2
# Never elect an out-of-sync replica as leader: availability loss > data loss
unclean.leader.election.enable=false

# Internal topics must be as durable as business topics
offsets.topic.replication.factor=3
transaction.state.log.replication.factor=3
transaction.state.log.min.isr=2
share.coordinator.state.topic.replication.factor=3
share.coordinator.state.topic.min.isr=2

############################# Topics #############################
# Topics are created deliberately (RF, partitions, retention reviewed), not by typos
auto.create.topics.enable=false
num.partitions=3
log.retention.hours=168
log.segment.bytes=1073741824

############################# Operations #############################
# Move leadership back to preferred replicas after a node returns
auto.leader.rebalance.enable=true
controlled.shutdown.enable=true
num.network.threads=3
num.io.threads=8
